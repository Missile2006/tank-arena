{
  "name": "tank-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev -w tank-arena-client",
    "dev:server": "npm run dev -w tank-arena-server",
    "build": "npm run build -w tank-arena-client",
    "start": "npm run start -w tank-arena-server",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p server/tsconfig.json && tsc -p client/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "fast-check": "^4.10.3",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
